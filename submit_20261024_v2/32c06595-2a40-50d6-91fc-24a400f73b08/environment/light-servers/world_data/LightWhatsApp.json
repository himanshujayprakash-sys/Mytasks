  },
  {
   "conversation_id": "conv-llh-2613",
   "direction": "inbound",
   "from_wa_id": "447700900313",
   "message_id": "wamid.llh0010",
   "sent_at": "2026-09-25T10:00:00Z",
   "status": "read",
   "template_name": "",
   "text": "Where's parking on Sunday?",
   "to_wa_id": "441632960455",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2613",
   "direction": "outbound",
   "from_wa_id": "441632960455",
   "message_id": "wamid.llh0011",
   "sent_at": "2026-09-25T10:15:00Z",
   "status": "read",
   "template_name": "",
   "text": "Park and ride from the college; the seafront is closed.",
   "to_wa_id": "447700900313",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2648",
   "direction": "inbound",
   "from_wa_id": "447700900348",
   "message_id": "wamid.llh0027",
   "sent_at": "2026-09-28T20:00:00Z",
   "status": "read",
   "template_name": "",
   "text": "Can I drop my sponsorship cash at the shop?",
   "to_wa_id": "441632960455",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2648",
   "direction": "outbound",
   "from_wa_id": "441632960455",
   "message_id": "wamid.llh0028",
   "sent_at": "2026-09-28T20:10:00Z",
   "status": "read",
   "template_name": "",
   "text": "Yes, ask for a paying-in slip.",
   "to_wa_id": "447700900348",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2635",
   "direction": "inbound",
   "from_wa_id": "447700900335",
   "message_id": "wamid.llh0018",
   "sent_at": "2026-09-30T19:00:00Z",
   "status": "read",
   "template_name": "",
   "text": "Can my kids come in the tent?",
   "to_wa_id": "441632960455",
