   "status": "read",
   "template_name": "",
   "text": "Of course!",
   "to_wa_id": "447700900335",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2617",
   "direction": "inbound",
   "from_wa_id": "447700900317",
   "message_id": "wamid.llh0003",
   "sent_at": "2026-10-01T20:14:00Z",
   "status": "read",
   "template_name": "",
   "text": "Hi Ffion, bad news - the physio says I've got a stress fracture in my left foot so Sunday is off. Can I defer my place to next year's race please? I'll keep my page open.",
   "to_wa_id": "441632960455",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2617",
   "direction": "outbound",
   "from_wa_id": "441632960455",
   "message_id": "wamid.llh0004",
   "sent_at": "2026-10-01T20:31:00Z",
   "status": "read",
   "template_name": "",
   "text": "So sorry Hollie! Yes, that's fine - I've noted your deferral to 2027. Rest up and we'll see you next year.",
   "to_wa_id": "447700900317",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2617",
   "direction": "inbound",
   "from_wa_id": "447700900317",
   "message_id": "wamid.llh0005",
