   "message_id": "wamid.llh0002",
   "sent_at": "2026-09-12T18:41:00Z",
   "status": "read",
   "template_name": "",
   "text": "Yes - 200 m past the start pens, by the lifeboat station.",
   "to_wa_id": "447700900317",
   "type": "text"
  },
  {
   "conversation_id": "conv-llh-2601",
   "direction": "inbound",
   "from_wa_id": "447700900301",
   "message_id": "wamid.llh0031",
   "sent_at": "2026-09-20T12:00:00Z",
   "status": "read",
   "template_name": "",
   "text": "When do vests arrive?",
   "to_wa_id": "441632960455",
