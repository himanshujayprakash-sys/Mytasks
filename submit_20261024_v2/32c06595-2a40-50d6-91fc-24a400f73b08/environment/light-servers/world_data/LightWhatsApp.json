  },
  {
   "conversation_id": "conv-llh-2601",
   "direction": "outbound",
   "from_wa_id": "441632960455",
   "message_id": "wamid.llh0032",
   "sent_at": "2026-09-20T12:05:00Z",
   "status": "read",
   "template_name": "",
   "text": "This week - we'll text you.",
   "to_wa_id": "447700900301",
