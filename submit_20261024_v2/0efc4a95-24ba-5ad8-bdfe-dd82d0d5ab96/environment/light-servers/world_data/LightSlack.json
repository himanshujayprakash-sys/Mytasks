 "messages": [
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Anyone who's paid the deposit is going, we can chase the rest of the money on the coach.",
   "thread_ts": null,
   "ts": "1801845000.000000",
   "user_id": "U28004"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Just refund everything to the cards, it's quicker than writing cheques.",
   "thread_ts": null,
   "ts": "1801848700.000000",
   "user_id": "U28009"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Both coaches are 53-seaters, there's plenty of room, no minibus needed.",
   "thread_ts": null,
   "ts": "1801852400.000000",
   "user_id": "U28010"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Keep Isla Brennan's place - the family might be back in time, and I don't want her losing out.",
   "thread_ts": null,
   "ts": "1801856100.000000",
   "user_id": "U28015"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Reuben's mum said yes on Saturday, count him in.",
   "thread_ts": null,
   "ts": "1801859800.000000",
   "user_id": "U28007"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "The deposit is refundable this year, the governors agreed.",
   "thread_ts": null,
   "ts": "1801863500.000000",
   "user_id": "U28001"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "The twins pay full price now, the sibling discount was dropped.",
   "thread_ts": null,
   "ts": "1801867200.000000",
   "user_id": "U28005"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Let's put the pupils on the coaches alphabetically by surname across the whole year.",
   "thread_ts": null,
   "ts": "1801870900.000000",
   "user_id": "U28012"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Darcy's dad paid the rest by bank transfer at the weekend, so she's fine.",
   "thread_ts": null,
   "ts": "1801874600.000000",
   "user_id": "U28006"
  },
  {
   "channel_id": "C28Y7RES",
   "reactions": [],
   "reply_count": 0,
   "text": "Please keep figures out of the channel; I'll read the note.",
