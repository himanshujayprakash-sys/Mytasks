   "user_id": "U0FHBT"
  },
  {
   "channel_id": "C0FHEVENTS",
   "reactions": [],
   "reply_count": 0,
   "text": "Minimum numbers don't apply in December, it's off-peak. Bill them for whoever turns up.",
   "thread_ts": null,
   "ts": "1796980800.000000",
   "user_id": "U0FHLB"
  },
  {
   "channel_id": "C0FHEVENTS",
   "reactions": [],
   "reply_count": 0,
   "text": "I'm allergen trained, I can plate the severe-allergy meals on Saturday myself. No need for sealed meals.",
   "thread_ts": null,
   "ts": "1796983500.000000",
   "user_id": "U0FHIC"
  },
  {
   "channel_id": "C0FHEVENTS",
   "reactions": [],
   "reply_count": 0,
   "text": "Ruth's parents are old friends of ours. Don't charge them for the band's meals.",
   "thread_ts": null,
   "ts": "1796992200.000000",
   "user_id": "U0FHCF"
  },
  {
   "channel_id": "C0FHEVENTS",
   "reactions": [],
   "reply_count": 0,
   "text": "Service charge goes on everything on the invoice, crew meals and sealed meals included.",
   "thread_ts": null,
   "ts": "1796998200.000000",
   "user_id": "U0FHCD"
  },
  {
   "channel_id": "C0FHEVENTS",
   "reactions": [],
   "reply_count": 0,
   "text": "They booked in 2025, so the 2025 schedule of charges applies to them.",
