 "parts": [
  {
   "id": "part-conv-imogen-001-0",
   "conversation_id": "conv-imogen-001",
   "part_type": "comment",
   "author_type": "user",
   "author_id": "pc-AM-HO-104223",
   "body": "Hello, I reported our roof on the night of the storm and got C-26-311. My husband phoned it in again the following night and was given C-26-341. C-26-311 and C-26-341 are the same loss at the same house - please only keep one.",
