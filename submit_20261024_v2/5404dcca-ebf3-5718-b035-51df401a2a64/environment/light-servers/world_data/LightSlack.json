   "ts": "1796635200.000000",
   "user_id": "U9TRN"
  },
  {
   "channel_id": "C9ALLOC",
   "reactions": [],
   "reply_count": 0,
   "text": "The leeks in bay 3 are fine for Wednesday, the date is only a day out.",
   "thread_ts": null,
   "ts": "1796636400.000000",
   "user_id": "U9GIN"
  },
  {
   "channel_id": "C9ALLOC",
   "reactions": [],
   "reply_count": 0,
   "text": "Ruling from me: Ristorante Valli get their full six cases of vine tomatoes, they're our biggest trade account. Confirm here when it's in.",
