   "ts": "1796638800.000000",
   "user_id": "U9GID"
  },
  {
   "channel_id": "C9ALLOC",
   "reactions": [],
   "reply_count": 0,
   "text": "Treloar's moved up to class C this month, Hollis signed it off.",
