  },
  {
   "id": "block-tj-001",
   "page_id": "page-tj-pressing",
   "parent_block_id": null,
   "type": "paragraph",
   "order": 1,
   "text": "Start 6v4 in a box; trigger the press on a backward pass; progress to 8v8 with goals.",
   "created_time": "2026-09-10T09:00:00.000Z",
   "last_edited_time": "2026-09-10T09:00:00.000Z",
   "has_children": false
  },
  {
   "id": "block-tj-002",
   "page_id": "page-tj-firsttouch",
   "parent_block_id": null,
   "type": "paragraph",
   "order": 2,
   "text": "Four gates, two balls per pair; receive across the body, play out of the gate.",
   "created_time": "2026-09-10T09:00:00.000Z",
   "last_edited_time": "2026-09-10T09:00:00.000Z",
   "has_children": false
  },
