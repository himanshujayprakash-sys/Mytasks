 "messages": [
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Put all four Dutch dealer pictures on one van. Splitting the Amsterdam consignment doubles the courier cost for nothing.",
   "thread_ts": null,
   "ts": "1795424400.000000",
   "user_id": "U27009"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Use Bryony's market rates for the euro and krona values, they're the latest we have.",
   "thread_ts": null,
   "ts": "1795429800.000000",
   "user_id": "U27002"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Aldred are a museum, so their two go under the indemnity like the other museums.",
   "thread_ts": null,
   "ts": "1795435200.000000",
   "user_id": "U27001"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Couriers by seniority this time, surely. Hollis should take the big Swedish loan.",
   "thread_ts": null,
   "ts": "1795440600.000000",
   "user_id": "U27006"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Keel & Lantern's premium is 0.18% flat, same as last year.",
   "thread_ts": null,
   "ts": "1795446000.000000",
   "user_id": "U27011"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "I'm off 22-26 February, I've put in for it, so leave me off those trips.",
   "thread_ts": null,
   "ts": "1795451400.000000",
   "user_id": "U27007"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Garside's agreement is as good as signed, count their two pictures in.",
   "thread_ts": null,
   "ts": "1795456800.000000",
   "user_id": "U27005"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "The Carrow & Webb values are as in their agreement, nothing's changed there.",
   "thread_ts": null,
   "ts": "1795462200.000000",
   "user_id": "U27008"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "The 2027 rate schedule is out, use that for the premium, it's cheaper.",
   "thread_ts": null,
   "ts": "1795467600.000000",
   "user_id": "U27009"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "Please don't post figures in here; I'll take them from the note.",
   "thread_ts": null,
   "ts": "1795473000.000000",
   "user_id": "U27000"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "All the condition checks are done now.",
   "thread_ts": null,
   "ts": "1795478400.000000",
   "user_id": "U27003"
  },
  {
   "channel_id": "C27LOANS",
   "reactions": [],
   "reply_count": 0,
   "text": "The Strandhuis van comes on the 12th as booked.",
   "thread_ts": null,
   "ts": "1795483800.000000",
   "user_id": "U27002"
  },
  {
   "channel_id": "C27BUILD",
   "reactions": [],
   "reply_count": 0,
   "text": "Goods lift service on 2 December, 07:00-09:00.",
   "thread_ts": null,
   "ts": "1795338000.000000",
   "user_id": "U27016"
  },
  {
   "channel_id": "C27BUILD",
   "reactions": [],
   "reply_count": 0,
   "text": "The gallery 4 blinds are fixed.",
   "thread_ts": null,
   "ts": "1795251600.000000",
   "user_id": "U27016"
  },
  {
   "channel_id": "C27BUILD",
   "reactions": [],
   "reply_count": 0,
   "text": "Fire alarm test Thursday 10:00 as usual.",
   "thread_ts": null,
   "ts": "1795165200.000000",
   "user_id": "U27016"
  },
  {
   "channel_id": "C27BUILD",
   "reactions": [],
   "reply_count": 0,
   "text": "Yard gritting from tonight.",
   "thread_ts": null,
   "ts": "1795078800.000000",
   "user_id": "U27016"
  },
  {
   "channel_id": "C27BUILD",
   "reactions": [],
   "reply_count": 0,
   "text": "Lantern night set-up starts 15:00 on 10 December.",
   "thread_ts": null,
   "ts": "1794992400.000000",
   "user_id": "U27016"
  }
 ]
